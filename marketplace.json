        "action-oriented",
        "subagent-control",
        "context-preservation"
      ],
      "keywords": [
        "bash-loop",
        "feedback",
        "action",
        "tight-loop",
        "efficiency"
      ],
      "license": "MIT",
      "homepage": "https://github.com/TheGlitchKing/aeon-flux",
      "status": "production-ready",
      "features": {
        "skills": [
          "/bash-loop",
          "/abort",
          "/focus",
          "/reflect",
          "/checkpoint",
          "/resume"
        ]
      }
    },
    {
      "id": "gimme-the-lint",
      "name": "gimme-the-lint",
      "displayName": "Gimme The Lint",
      "type": "claude-plugin",
      "version": "1.2.0",
      "description": "Progressive linting with directory-chunked baselines, drift detection, and auto-healing for monorepo projects (Python + JS/TS)",
      "author": {
        "name": "TheGlitchKing"
      },
      "repository": {
        "type": "github",
        "owner": "TheGlitchKing",
        "repo": "gimme-the-lint",
        "url": "https://github.com/TheGlitchKing/gimme-the-lint"
      },
      "source": {
        "type": "npm",
        "package": "@theglitchking/gimme-the-lint"
      },
      "installation": {
        "methods": [
          {
            "type": "npm",
            "command": "npm install --save-dev @theglitchking/gimme-the-lint && npx gimme-the-lint install"
          },
          {
            "type": "npx",
            "command": "npx @theglitchking/gimme-the-lint install"
          },
          {
            "type": "claude-marketplace",
            "command": "/plugin install TheGlitchKing/gimme-the-lint"
          },
          {
            "type": "github-action",
            "uses": "TheGlitchKing/gimme-the-lint@v1"
          }
        ],
        "requirements": {
          "node": ">=20.0.0",
          "python": ">=3.8 (optional, for backend linting)",
          "claude-code": ">=1.0.0"
        }
      },
      "category": "productivity",
      "tags": [
        "linting",
        "progressive-linting",
        "eslint",
        "ruff",
        "python",
        "monorepo",
        "git-hooks",
        "drift-detection",
        "github-action"
      ],
      "keywords": [
        "linting",
        "progressive",
        "baseline",
        "eslint",
        "ruff",
        "python",
        "javascript",
        "typescript",
        "monorepo",
        "drift-detection",
        "auto-healing"
      ],
      "license": "MIT",
      "homepage": "https://github.com/TheGlitchKing/gimme-the-lint",
      "status": "production-ready",
      "features": {
        "commands": [
          "/lint",
          "/lint:status",
          "/lint:baseline"
        ]
      }
    },
    {
      "id": "babel-fish",
      "name": "babel-fish",
      "displayName": "Babel Fish",
      "type": "claude-plugin",
      "version": "2.0.0",
      "description": "Auto-generates a project map, vocabulary translation layer, and developer skill for any codebase. Introspects routes, models, services, features, infrastructure, and session history to give Claude instant full-stack context. Self-updates via pre-commit hook. Iterative install with 90% quality threshold and human-readable grading reports.",
      "author": {
        "name": "TheGlitchKing"
      },
      "repository": {
        "type": "github",
        "owner": "TheGlitchKing",
        "repo": "babel-fish",
        "url": "https://github.com/TheGlitchKing/babel-fish"
      },
      "source": {
        "type": "npm",
        "package": "@theglitchking/babel-fish"
      },
      "installation": {
        "methods": [
          {
            "type": "npm",
            "command": "npm install -g @theglitchking/babel-fish && babel-fish init"
          },
          {
            "type": "npx",
            "command": "npx @theglitchking/babel-fish init"
          },
          {
            "type": "claude-marketplace",
            "command": "/plugin install babel-fish@glitch-kingdom-of-plugins"
          },
          {
            "type": "manual",
            "steps": [
              "git clone https://github.com/TheGlitchKing/babel-fish.git",
              "bash babel-fish/.claude/install.sh"
            ]
          }
        ],
        "requirements": {
          "claude-code": ">=1.0.0",
          "node": ">=20.0.0",
          "python": ">=3.8",
          "bash": true,
          "optional": {
            "pyyaml": "For YAML parsing in docker-compose files (falls back to regex)"
          }
        }
      },
      "category": "developer-tools",
      "tags": [
        "codebase-context",
        "project-map",
        "vocabulary",
        "developer-skill",
        "introspection",
        "drift-management"
      ],
      "keywords": [
        "project map",
        "babel fish",
        "vocabulary translation",
        "developer context",
        "code introspection",
        "auto-generated docs",
        "semantic drift",
        "technical translator"
      ],
      "license": "MIT",
      "homepage": "https://github.com/TheGlitchKing/babel-fish",
      "status": "production-ready",
      "features": {
        "hooks": [
          "pre-commit (auto-regenerate project map on source file changes)"
        ],
        "skills": [
          "/<project-slug>-developer-skill"
        ],
        "commands": [
          "python .claude/project-map/generate.py --force",
          "python .claude/project-map/grader.py",
          "python .claude/project-map/mine-sessions.py"
        ]
      }
    },
